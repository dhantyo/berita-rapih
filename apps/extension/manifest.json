{
  "manifest_version": 3,
  "name": "Sapu Berita",
  "version": "0.4.0",
  "description": "Baca berita Indonesia tanpa iklan dan tanpa \"Baca Juga\"; semua halaman digabung jadi satu.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.antaranews.com/*",
        "https://*.beritasatu.com/*",
        "https://*.bisnis.com/*",
        "https://*.cnbcindonesia.com/*",
        "https://*.cnnindonesia.com/*",
        "https://*.detik.com/*",
        "https://*.idntimes.com/*",
        "https://*.inews.id/*",
        "https://*.jawapos.com/*",
        "https://*.jpnn.com/*",
        "https://*.katadata.co.id/*",
        "https://*.kompas.com/*",
        "https://*.kompas.tv/*",
        "https://*.kontan.co.id/*",
        "https://*.kumparan.com/*",
        "https://*.liputan6.com/*",
        "https://*.medcom.id/*",
        "https://*.mediaindonesia.com/*",
        "https://*.merdeka.com/*",
        "https://*.okezone.com/*",
        "https://*.pikiran-rakyat.com/*",
        "https://*.republika.co.id/*",
        "https://*.sindonews.com/*",
        "https://*.suara.com/*",
        "https://*.tirto.id/*",
        "https://*.tribratanews.polri.go.id/*",
        "https://*.tribunnews.com/*",
        "https://*.viva.co.id/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "version_name": "0.4.0"
}
