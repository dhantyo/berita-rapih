{
  "manifest_version": 3,
  "name": "Sapu Berita",
  "version": "0.8.1",
  "description": "Baca beritanya, sapu sisanya. Iklan dan pop-up hilang, artikel yang dipecah jadi beberapa halaman digabung jadi satu.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.antaranews.com/*",
        "https://*.beritasatu.com/*",
        "https://*.bisnis.com/*",
        "https://*.cnbcindonesia.com/*",
        "https://*.cnnindonesia.com/*",
        "https://*.detik.com/*",
        "https://*.dw.com/*",
        "https://*.idntimes.com/*",
        "https://*.inews.id/*",
        "https://*.jawapos.com/*",
        "https://*.jpnn.com/*",
        "https://*.katadata.co.id/*",
        "https://*.kompas.com/*",
        "https://*.kompas.tv/*",
        "https://*.kontan.co.id/*",
        "https://*.kumparan.com/*",
        "https://*.liputan6.com/*",
        "https://*.medcom.id/*",
        "https://*.mediaindonesia.com/*",
        "https://*.merdeka.com/*",
        "https://*.okezone.com/*",
        "https://*.pikiran-rakyat.com/*",
        "https://*.republika.co.id/*",
        "https://*.sindonews.com/*",
        "https://*.suara.com/*",
        "https://*.tirto.id/*",
        "https://*.tribratanews.polri.go.id/*",
        "https://*.tribunnews.com/*",
        "https://*.viva.co.id/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "version_name": "0.8.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sapu Berita",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
